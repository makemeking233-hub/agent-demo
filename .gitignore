# JetBrains IDE
.idea/
# IDE temp files (atomic write leftovers: ..gitignore.<pid>.<uuid>.tmpdir)
*..*.tmpdir
*..*.tmp

# VS Code
.vscode/
*.iml

# Build output
target/

# OS
.DS_Store
Thumbs.db

# Backup / corrupt files
docs/test-design.md.corrupt.bak

# Local tools (e.g. google-java-format jar for manual formatting)
# 注意：必须用 /tools/ 而非 tools/，否则会误匹配 src/main/java/com/example/agent/tools/
/tools/

# 本地 gitleaks 二进制（22MB，勿提交；配置 .gitleaks.toml 与 CI 工作流保留提交）
/.tools/

# gitleaks 本地扫描残留（测试假密钥文件 / JSON 报告）
.gitleaks-test-fake-secret.txt
.rbase.json
gitleaks-report*.json

# Node.js dependencies（mermaid 验证脚本等需要）
node_modules/

# frontend-maven-plugin 下载的 Node.js 二进制（~70MB，需 Git LFS 才能提交；本项目不要）
agent-web/frontend/node/
agent-web/frontend/package-lock.json

# OpenSpec 生成的 Claude Code 工具文件（本项目用 DSH，工具已复制到 .dsh/）
.claude/

# 本地密钥 / 私密配置（Spring Boot 标准 local profile + 兜底匹配常见命名）
application-local.yml
application-local.yaml
application-local.properties
*-local.yml
*-local.yaml
*.local.yml
*.local.yaml
secrets.yml
secrets.yaml
.env
.env.local

# agent-demo 运行时遗留（记忆目录被误生成在工作目录；正确位置应为 ~/.agent-demo/）
.agent-demo/
# 测试/运行验证产生的本地日志（含 web/spring boot 启动 probe 日志）
/test-logs/

# agent-demo 运行时日志专门目录（项目内 logs/，不跟踪日志文件与会话日志）
/logs/
/logs/app.log*
/logs/sessions/
*.log
