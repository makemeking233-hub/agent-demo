<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>agent-demo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>agent-core</artifactId>
    <packaging>jar</packaging>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <picocli.version>4.7.6</picocli.version>
        <jline.version>3.25.1</jline.version>
        <jtokkit.version>0.6.1</jtokkit.version>
    </properties>
    <dependencies>
        <!-- picocli + Spring Boot 注解扫描 -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-spring-boot-starter</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!-- CLI 终端 -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <!-- LLM HTTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- YAML -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- Token 估算 -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>${jtokkit.version}</version>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jna</artifactId>
            <version>${jline.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.6.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>agent-cli</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.agent.AgentCli</mainClass>
                    <!-- 关键: 用 classifier=exec 把 repackage 的 fat jar 命名为 agent-cli-exec.jar,
                         保留 agent-cli.jar 为普通库 jar。否则 repackage 会把 agent-cli.jar 替换成
                         Spring Boot fat jar (BOOT-INF/ 内层结构), 同一 reactor 里 agent-web 编译时
                         无法解析 com.example.agent.* 类 (见 SseSessionLogSink 编译失败根因)。 -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <!-- fix-jacoco-rule：逐包考核（与 agent-web 一致）。
                                 exclude 清单在 T1 实测后按缺口与「无测试覆盖意图」原则确定。 -->
                            <excludes>
                                <!-- AgentCli：JVM 入口，main() 不在单测中调用；
                                     既有 AgentCliTest 仅覆盖 picocli 派发路径，不覆盖 main() -->
                                <exclude>com/example/agent/AgentCli.*</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <!-- 与原 BUNDLE 规则对齐 5 个包；删除 com.example.agent.agent.*（指向不存在包） -->
                                        <include>com.example.agent.provider</include>
                                        <include>com.example.agent.tools</include>
                                        <include>com.example.agent.permission</include>
                                        <include>com.example.agent.session</include>
                                        <include>com.example.agent.memory</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- fix-agent-home-isolation：测试 JVM 默认隔离。
                 这个项目里「跑测试不污染真实 ~/.agent-demo」的正确性此前寄托于每个测试作者
                 都记得在静态块里 System.setProperty("agent.demo.home", ...)——实测只有 3 个
                 测试这么做了，其余测试每次运行都在用户真实 logs/sessions 下建目录。
                 改为默认值后，「忘记设置」的后果变成安全的。
                 优先级见 com.example.agent.config.AgentPaths（属性 → env → user.home），
                 未设置时行为与改造前逐字一致。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <agent.demo.home>${project.build.directory}/test-home</agent.demo.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>